<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <!-- Шапка -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#1A237E"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Шаблоны"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Список шаблонов (обычный ScrollView для простоты) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp"> <!-- Отступ для кнопки + -->

            <!-- Карточка 1 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_edittext" android:padding="16dp" android:layout_marginBottom="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📦 Хрупкий груз" android:textStyle="bold" android:textSize="16sp" android:textColor="#212121"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Стекло, керамика • вес до 20 кг" android:textColor="#757575" android:layout_marginBottom="12dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnUse1" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="Использовать" android:textColor="#757575" app:strokeColor="#D0D0D0" app:cornerRadius="8dp"/>
            </LinearLayout>

            <!-- Карточка 2 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_edittext" android:padding="16dp" android:layout_marginBottom="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📄 Документы" android:textStyle="bold" android:textSize="16sp" android:textColor="#212121"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Бумаги, папки • вес до 5 кг" android:textColor="#757575" android:layout_marginBottom="12dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnUse2" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="Использовать" android:textColor="#757575" app:strokeColor="#D0D0D0" app:cornerRadius="8dp"/>
            </LinearLayout>

            <!-- Карточка 3 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_edittext" android:padding="16dp" android:layout_marginBottom="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🪑 Мебель" android:textStyle="bold" android:textSize="16sp" android:textColor="#212121"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Крупногабарит • до 100 кг" android:textColor="#757575" android:layout_marginBottom="12dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnUse3" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="Использовать" android:textColor="#757575" app:strokeColor="#D0D0D0" app:cornerRadius="8dp"/>
            </LinearLayout>

            <!-- Карточка 4 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_edittext" android:padding="16dp" android:layout_marginBottom="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="❄️ Скоропортящееся" android:textStyle="bold" android:textSize="16sp" android:textColor="#212121"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Требует рефрижератор" android:textColor="#757575" android:layout_marginBottom="12dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnUse4" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="Использовать" android:textColor="#757575" app:strokeColor="#D0D0D0" app:cornerRadius="8dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Плавающая кнопка + -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddTemplate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#3F51B5"
        app:tint="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>